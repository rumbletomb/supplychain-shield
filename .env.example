NODE_ENV=development
DATABASE_URL=postgresql://shield:shield@localhost:5432/shield?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# GitHub App. The demo mode works without these values.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# Scanner limits
MAX_REPOSITORY_BYTES=52428800
SCAN_TIMEOUT_MS=180000
RETENTION_DAYS=30
