{
  "name": "supplychain-shield",
  "version": "0.1.0",
  "private": true,
  "description": "Developer-first software supply chain security for small teams.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @scs/database generate",
    "db:migrate": "pnpm --filter @scs/database migrate",
    "db:seed": "pnpm --filter @scs/database seed",
    "demo:scan": "pnpm --filter @scs/worker demo"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.4.1",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  }
}
